{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "baseName": {
      "value": "${BASE_NAME}"
    },
    "developmentEnvironment": {
      "value": true
    },
    "externalDatabaseDestinationPrefix": {
      "value": "*"
    },
    "externalDatabasePort": {
      "value": 1433
    },
    "sqlServer": {
      "value": "${SQL_SERVER}"
    },
    "sqlDatabase": {
      "value": "${SQL_DATABASE}"
    },
    "sqlUsername": {
      "value": "${SQL_USERNAME}"
    },
    "sqlPassword": {
      "value": "${SQL_PASSWORD}"
    },
    "runnerAdminUsername": {
      "value": "${RUNNER_ADMIN_USERNAME}"
    },
    "runnerAdminPassword": {
      "value": "${RUNNER_ADMIN_PASSWORD}"
    }
  }
}
